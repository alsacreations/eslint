{
  "name": "eslint-config-alsacreations",
  "version": "2.2.0",
  "description": "Configuration ESLint et Prettier d'Alsacréations",
  "packageManager": "pnpm@9.5.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/alsacreations/eslint"
  },
  "exports": {
    "./configs/javascript": {
      "import": "./dist/configs/javascript.js",
      "types": "./dist/configs/javascript.d.ts"
    },
    "./configs/prettier": {
      "import": "./dist/configs/prettier.js",
      "types": "./dist/configs/prettier.d.ts"
    },
    "./configs/typescript": {
      "import": "./dist/configs/typescript.js",
      "types": "./dist/configs/typescript.d.ts"
    },
    "./configs/vue": {
      "import": "./dist/configs/vue.js",
      "types": "./dist/configs/vue.d.ts"
    },
    "./configs/solid": {
      "import": "./dist/configs/solid.js",
      "types": "./dist/configs/solid.d.ts"
    },
    "./configs/solid-typescript": {
      "import": "./dist/configs/solid-typescript.js",
      "types": "./dist/configs/solid-typescript.d.ts"
    }
  },
  "bin": "dist/bin/bin.js",
  "scripts": {
    "build": "tsup",
    "release": "pnpm changelogen --release --push --token $(gh auth token)",
    "bin-exec": "tsx bin/bin.ts init"
  },
  "files": [
    "dist",
    "tsconfig.json"
  ],
  "keywords": [],
  "author": "Alsacréations",
  "license": "ISC",
  "peerDependencies": {
    "eslint": "^9.6.0",
    "eslint-plugin-solid": "^0.14.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint-plugin-vue": "^9.27.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-solid": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "eslint-config-prettier": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^20.14.10",
    "@types/prettier": "^2.7.3",
    "eslint-plugin-solid": "^0.14.1",
    "bumpp": "^9.4.1",
    "changelogen": "^0.5.5",
    "eslint": "^9.6.0",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "type-fest": "^4.21.0",
    "typescript": "^5.5.3",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.27.0"
  },
  "dependencies": {
    "typescript-eslint": "^7.16.0",
    "@eslint/js": "^9.6.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "prettier": "^3.3.2",
    "execa": "^8.0.1",
    "fast-glob": "^3.3.2",
    "find-up": "^7.0.0",
    "local-pkg": "^0.5.0",
    "consola": "^3.2.3"
  }
}
